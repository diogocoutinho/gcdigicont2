# GC Digicont - Hostinger (LiteSpeed/Apache). Publicado junto com o export estático.
Options -MultiViews -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Domínio sem "www" (uma única versão canônica do site).
  # O HTTPS é forçado pelo painel da Hostinger (opção "Forçar HTTPS").
  RewriteCond %{HTTP_HOST} ^www\.gcdigicont\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://gcdigicont.com.br/$1 [L,R=301]

  # Servir /pagina/index.html para /pagina e /pagina/ (Next.js static export)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]
</IfModule>

# Tipos de arquivo
<IfModule mod_mime.c>
  AddType text/plain .txt
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
  AddCharset utf-8 .txt .html .css .js .json .xml
</IfModule>

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache: HTML e textos sempre revalidam; imagens 30 dias; JS/CSS com hash 1 ano
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Todo JS/CSS do export fica em /_next/static/ com hash no nome
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Segurança
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
